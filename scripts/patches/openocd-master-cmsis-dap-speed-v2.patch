+ * Rationale for keeping the compile-time capacity at MAX_PENDING_REQUESTS=8:
+ * this binary must be able to A/B the whole 1..8 depth range without a
+ * rebuild. Both knobs remain settable from the config stage. */
+static unsigned int pending_requests_override = 4;
+static bool eager_reads_override = true;
