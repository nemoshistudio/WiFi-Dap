+COMMAND_HANDLER(cmsis_dap_handle_pending_requests_command)
+{
+	if (CMD_ARGC > 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	if (CMD_ARGC == 1) {
+		unsigned int depth;
+		COMMAND_PARSE_NUMBER(uint, CMD_ARGV[0], depth);
+		if (depth < 1 || depth > MAX_PENDING_REQUESTS) {
+			command_print(CMD, "pending request depth must be in 1..%u", MAX_PENDING_REQUESTS);
+			return ERROR_COMMAND_ARGUMENT_INVALID;
+		}
+		pending_requests_override = depth;
+		return ERROR_OK;
+	}
+
+	command_print(CMD, "%u", pending_requests_override);
+
+	return ERROR_OK;
+}
+
+COMMAND_HANDLER(cmsis_dap_handle_eager_reads_command)
+{
+	if (CMD_ARGC > 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	if (CMD_ARGC == 1) {
+		COMMAND_PARSE_ENABLE(CMD_ARGV[0], eager_reads_override);
+		return ERROR_OK;
+	}
+
+	command_print(CMD, "%s", eager_reads_override ? "enabled" : "disabled");
+
+	return ERROR_OK;
+}
