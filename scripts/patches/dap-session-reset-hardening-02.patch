+/* dap_respond counts the responses waiting in the OUT ring.  It is updated by
+ * the DAP task (producer) and decremented by the TCP task (fast_reply /
+ * pipeline take).  A session reset races with the consumer, so the decrement
+ * is clamped and a reset uses dap_respond_reset() instead of a bare
+ * "dap_respond = 0". */
+static void dap_respond_add(int delta)
+{
+    if (data_response_mux && xSemaphoreTake(data_response_mux, portMAX_DELAY) == pdTRUE) {
+        if (delta < 0) {
+            if (dap_respond > 0) {
+                --dap_respond;
+            }
+        } else {
+            ++dap_respond;
+        }
+        xSemaphoreGive(data_response_mux);
+    }
+}
+
+static void dap_respond_reset(void)
+{
+    if (data_response_mux && xSemaphoreTake(data_response_mux, portMAX_DELAY) == pdTRUE) {
+        dap_respond = 0;
+        xSemaphoreGive(data_response_mux);
+    }
+}
