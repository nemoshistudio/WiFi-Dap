# WiFi Dap -- ESP32-C5 (Wi-Fi-only) default configuration.
#
# Target: ESP32-C5 v1.2 DevKitC-1-N8R8 / WROOM-1-N8R8 (8 MB flash, 8 MB PSRAM).
# Real-hardware validated on 2026-10-25 (branch c5/hw): boot, 2.4/5 GHz STA,
# Web/API, OTA, USBIP CMSIS-DAP; see docs/esp32-c5-port.md §11 for the measured
# results and the remaining limitations.
#
# ESP-IDF: unified v5.5.6 baseline for every target (the C5 needs >= v5.5.2).
# Build with:
#   scripts/build_all.sh -t esp32c5          # image comes from idf-docker.sh
#   IDF_DOCKER_IMAGE_C5=espressif/idf:v5.5.6 scripts/build_all.sh -t esp32c5
#
# ESP32-C5 has NO USB-OTG (USB Serial/JTAG only), therefore this variant is
# Wi-Fi-only: no USB-NCM/TinyUSB, no wired-DAP transport. The USB port is used
# for the secondary console / flashing / C5's own JTAG only.
#
# 8 MB flash + the frozen dual-OTA layout (2 x 3 MB app slots) is reused from
# the ESP32-S3 build so the Web/OTA/curve byte budgets are identical.

#
# Target / toolchain
#
CONFIG_IDF_TARGET="esp32c5"
CONFIG_IDF_TARGET_ARCH_RISCV=y

#
# Flash: 8 MB (DevKitC-1-N8R8), frozen dual-OTA partition table
#
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_8mb_ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/partitions_8mb_ota.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

#
# App / OTA: same rollback contract as the S3 release build
#
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

#
# CPU: ESP32-C5 HP core up to 240 MHz (DAP SWD bit-banging uses the fast path)
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

#
# Console: UART0 primary (same as S3), USB-Serial/JTAG secondary.
# There is no USB-OTG/NCM on C5, so the USB pads are free for the console.
#
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

#
# Board: ESP32-C5 reference wiring (components/board/Kconfig)
#
CONFIG_BIRDIEBOT_BOARD_GENERIC_C5=y

#
# Wi-Fi band mode (C5 only): 2.4 GHz + 5 GHz auto selection by the driver.
# AUTO is NOT simultaneous dual-band; AP and STA stay on the same band. See
# docs/esp32-c5-port.md §11 (5 GHz bring-up). The legacy 2.4 GHz-only mode is
# selectable via CONFIG_BIRDIEBOT_WIFI_BAND_MODE_2G_ONLY.
#
CONFIG_BIRDIEBOT_WIFI_BAND_MODE_AUTO=y

#
# First-boot STA provisioning: empty in the committed defaults. For local
# real-device bring-up use an *untracked* sdkconfig overlay (never commit real
# credentials), see project_components/wifi_manager/Kconfig:
#   CONFIG_BIRDIEBOT_WIFI_STA_PROV_SSID="..." / ..._PASSWORD="..."
#
CONFIG_BIRDIEBOT_WIFI_STA_PROV_SSID=""
CONFIG_BIRDIEBOT_WIFI_STA_PROV_PASSWORD=""

#
# Single-core target: never pin the USBIP tcp_server task to core 1
#
CONFIG_BIRDIEBOT_USBIP_TCP_CORE=0

#
# Internal-RAM budget (real C5 hardware, 2026-10-25)
#
# The single-core ESP32-C5 has 384 KiB HP SRAM but only ~146 KiB ends up in the
# dynamic heap (IDF+Wi-Fi static data takes the rest), far less than the S3.
# Measured on the N8R8 DevKit: after the web server + URI modules the internal
# heap was down to ~3 KiB, so the USBIP DAP task could not be created and
# OpenOCD failed with "CMSIS-DAP command CMD_INFO failed" - even though the
# device enumerated through USBIP.  These Wi-Fi buffer reductions keep enough
# internal RAM for the DAP task and its ring buffers.
#
# Static RX buffers: ~1.6 KiB each, allocated up front by esp_wifi_init().
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# Dynamic RX/TX buffers are allocated on demand; the DAP/Web traffic does not
# need the default 32-slot budget.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# Management buffers (small; also allocated up front).
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

#
# 8 MB PSRAM on the WROOM-1-N8R8 / DevKitC-1-N8R8 module.
#
# Real C5 hardware: even after the Wi-Fi/stack reductions above, the internal
# heap cannot hold [web server + target-flash worker + DAP task + DAP rings +
# OTA upload buffer] at the same time.  PSRAM is used for the big CPU-only
# buffers (DAP ring storage via xRingbufferCreateWithCaps, HTTP/cJSON/curve
# buffers via the 8 KiB internal threshold); task stacks, DMA buffers, Wi-Fi
# and flash-write buffers stay in internal RAM.
#
# Measured on hardware: "Found 8MB PSRAM device", "Adding pool of 8192K",
# boot + Wi-Fi + Web + USBIP + OTA verified (docs/esp32-c5-port.md §11).
# Without PSRAM the DAP task cannot be created (USBIP enumerates but OpenOCD
# gets "CMSIS-DAP command CMD_INFO failed").
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Only allocations smaller than 8 KiB are forced into internal RAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192

#
# Wi-Fi-only variant: no USB-OTG/NCM/TinyUSB (option not even visible on C5)
#
CONFIG_BIRDIEBOT_WIRED_TRANSPORT_NONE=y

#
# Web UI: WebSocket support (same server/URI modules as the other targets)
#
CONFIG_HTTPD_WS_SUPPORT=y

#
# Unused radios: this variant is Wi-Fi-only. ESP-IDF v5.5 enables the C5
# 802.15.4 (Thread/Zigbee) stack by default; keep it (and BLE) off so the
# firmware only contains the Wi-Fi path the project actually uses.
#
# CONFIG_BT_ENABLED is not set
# CONFIG_IEEE802154_ENABLED is not set
# CONFIG_OPENTHREAD_ENABLED is not set

#
# Logging: keep the same default level/colour behaviour as the other targets
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
