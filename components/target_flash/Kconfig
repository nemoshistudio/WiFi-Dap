menu "WiFi Dap target flash engine (Web-side direct flashing)"

    # The engine itself has no tunables yet: erase/programming strategies are
    # per-target-family and hard-coded (STM32F4 x64->x32 fallback, STM32H7
    # 256-bit flash word).  Kept as a menu so future knobs land here.

    config BIRDIEBOT_TARGET_FLASH_DEBUG_HTTP
        bool "Enable /tf debug HTTP endpoint (bring-up verification only)"
        default n
        help
            Registers a minimal HTTP endpoint on the existing web server for
            hardware bring-up and lab verification without the Web UI:

              POST /tf/probe    probe the SWD target, return JSON info
              POST /tf/status   return the current status snapshot
              POST /tf/flash    body = raw image, program+verify+reset, return
                                JSON with expected/actual SHA-256 and timings
              POST /tf/abort    abort a running flash
              POST /tf/pc       halt, read the target PC, resume (reset check)

            The endpoint is protected by the normal web Host/Origin guard and
            an extra "X-WiFi Dap-Target-Flash: 1" request header.  It calls
            the same blocking engine API as the production Web flow, so it must
            only be enabled on a trusted LAN during bring-up.  Default: n.

endmenu
